# Copy into backend/.env and restart the backend. The frontend fetches these
# values from /api/upload-limits; backend checks always remain authoritative.
MAX_IMAGE_SIZE_MB=10
MAX_SUBMISSION_SIZE_MB=50
MAX_ESSAY_PAGES=20
# Multi-page originals are stored in backend/uploads. Keep that directory on
# persistent storage; it is the same location used by existing fallback uploads.
