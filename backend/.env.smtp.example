# Copy these settings into backend/.env and restart the backend.
# Supabase Authentication SMTP settings are separate from these settings.
NOTIFICATIONS_ENABLED=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_FROM=your-address@gmail.com
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
APP_URL=http://localhost:3000
# Run one notification worker and keep its database on persistent storage.
# NOTIFICATIONS_DB=C:/persistent/writecheck-notifications.db
